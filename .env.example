# FOLIO — copy to .env (never commit .env)
# Research
TAVILY_API_KEY=
TINYFISH_API_KEY=
# LLM gateway (OpenAI-compatible). No OpenAI key required.
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=gpt-4o-mini
# UI registries
API_KEY_21ST=
SHADERS_API_KEY=
# Auth / multi-tenant (required for wallet sessions)
PRIVY_APP_ID=
PRIVY_APP_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT Secret (Dashboard → API) — arms user-JWT RLS path (sub = Privy DID). ≥16 chars.
SUPABASE_JWT_SECRET=
# HMAC for folio_session httpOnly cookie (≥16 chars). Never commit real value.
FOLIO_SESSION_SECRET=
# Solana / market data
SOLANA_RPC_URL=
BITQUERY_API_KEY=
# Optional Finnhub free quote (https://finnhub.io/register) — preferred live equity ref
FINNHUB_API_KEY=
# Pyth Hermes — off ship path (Pro paywall); free Yahoo/Finnhub used for diverge
# PYTH_API_KEY=
JUPITER_API_KEY=
# Broadcast / spend controls
BROADCAST_PAUSED=true
# Lab approve → production desk chrome (set ONLY after Henry chat reply)
# FOLIO_APPROVED_LAB_UI=netro-density
# FOLIO_APPROVED_LAB_SHADER=ink-ledger
# Optional
VENICE_API_KEY=

# --- Vercel preview (dashboard — cannot set from vercel.json) ---
# Required for watch-wallet bind on the public demo:
#   FOLIO_SESSION_SECRET=<≥16 chars>
#   BROADCAST_PAUSED=true
# Optional: SOLANA_RPC_URL (else labeled public mainnet RPC fallback)
